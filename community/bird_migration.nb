Cell[TextData[{
 "Figure 7.1  Pennycuick power curves for the three species. Each U-shaped \
curve is induced + parasite + profile power; the minimum marks ",
 StyleBox["V",
  FontFamily->"Times",
  FontSlant->Italic],
 StyleBox["mp",
  FontFamily->"Times",
  FontSlant->Italic],
 " and the tangent from the origin marks the max-range speed ",
 StyleBox["V",
  FontFamily->"Times",
  FontSlant->Italic],
 StyleBox["mr",
  FontFamily->"Times",
  FontSlant->Italic],
 ", where cost per kilometre is lowest and where a fuel-minimising migrant \
should cruise."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"266830fc-e001-4a37-844e-f0486f795b43"],

