Cell[TextData[{
 StyleBox["Privacy and attribution.",
  FontSlant->Italic],
 " Live coordinates are coarsened to one decimal place (~11 km) before \
plotting or storage, so no precise observer or sensitive-species location is \
republished. All live data are attributed to eBird.org (Cornell Lab of \
Ornithology) per the eBird Terms of Use."
}], "Text",
 CellMargins->{{50, 50}, {6, 
