Cell[TextData[{
 "Figure 9b.3  Red knot \[LongDash] recent eBird sightings (last 30 days, as \
of late June 2026). ",
 StyleBox["Source: eBird.org (Cornell Lab of Ornithology)",
  FontWeight->Bold],
 "."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"57338f3e-1f82-4c4c-aba6-8a1a2767c23d"],

Cell[TextData[{
 StyleBox["Privacy and attribution.",
  FontSlant->Italic],
 " Live coordinates are coarsened to one decimal place (~11 km) before \
plotting or storage, so no precise observer or sensitive-species location is \
republished. All live data are attributed to eBird.org (Cornell Lab of \
Ornithology) per the eBird Terms of Use."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"d601127d-e218-42c9-8053-dc8a82f822a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.  What each journey reveals", "Section",
 FontFamily->"Roboto Condensed",
 FontSize->30,
 FontColor->RGBColor[
  0.153, 0.51, 0.64],ExpressionUUID->"b9c6dfc0-53e2-4c6d-8656-57e16b3c8061"],

Cell["\<\
Read together, the three tracks tell three different stories about how a bird \
can solve the problem of seasonal survival. Plotting the centroid latitude \
against the month for all three at once makes the contrast plain:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"49642c3d-c3e5-491b-8636-420008a5e9da"],

