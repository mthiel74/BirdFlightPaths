Cell[TextData[{
 "Figure 9b.3  Red knot \[LongDash] recent eBird sightings (last 30 days, as \
of late June 2026). ",
 StyleBox["Source: eBird.org (Cornell Lab of Ornithology)",
  FontWeight->Bold],
 "."
}], "Text",
